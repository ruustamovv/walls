{
  "name": "@nexus/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PROJECT_NEXUS production backend — Fastify + MongoDB + Redis + Socket.io",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "db:setup": "tsx src/database/setup.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:indexes": "tsx src/database/indexes-cli.ts",
    "db:reset:dev": "tsx src/database/reset-dev.ts",
    "db:health": "tsx src/database/health-cli.ts",
    "verify:live": "npm run build && tsx src/database/live-verify.ts",
    "owner:create": "tsx src/scripts/create-owner.ts",
    "puzzles:pack": "tsx src/scripts/generate-puzzle-pack.ts",
    "env:check": "node ../../scripts/setup/env-check.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.9.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.5.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
