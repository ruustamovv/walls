{
  "name": "@nexus/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROJECT_NEXUS deterministic wall-and-pawn game engine (original implementation)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "pnpm run build && node --test \"dist/tests/**/*.test.js\"",
    "benchmark": "pnpm run build && node dist/benchmark/bench.js"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3"
  }
}
