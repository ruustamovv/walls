# =====================================================================
# Quoridor — quoridor.uz (minimal providers)
# Copy to `.env`: cp .env.example .env, then set MONGODB_URI + secrets
# =====================================================================

NODE_ENV=development
APP_NAME=Quoridor
FRONTEND_URL=https://quoridor.uz
ADMIN_URL=https://quoridor.uz:5174
BACKEND_URL=https://quoridor.uz:3000
API_URL=https://quoridor.uz:3000/api/v1
WS_URL=wss://quoridor.uz:3000/socket

# Local dev overrides (uncomment):
# FRONTEND_URL=http://localhost:5173
# ADMIN_URL=http://localhost:5174
# BACKEND_URL=http://localhost:3000
# API_URL=http://localhost:3000/api/v1
# WS_URL=ws://localhost:3000/socket

# ── REQUIRED: databases ──
MONGODB_URI=PASTE_YOUR_MONGODB_URI_HERE
MONGODB_DB_NAME=quoridor
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=quoridor

# ── REQUIRED: auth secrets (each distinct, openssl rand -base64 48) ──
JWT_SECRET=PASTE_YOUR_JWT_SECRET_HERE
COOKIE_SECRET=PASTE_YOUR_COOKIE_SECRET_HERE
SESSION_SECRET=PASTE_YOUR_SESSION_SECRET_HERE
CORS_ORIGINS=https://quoridor.uz

# ── Owner bootstrap (single-use) ──
OWNER_EMAIL=owner@quoridor.uz
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=PASTE_YOUR_BOOTSTRAP_PASSWORD_HERE

# ── AI (groq default; one provider enough) ──
AI_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
AI_MODEL_CHAT=
AI_MODEL_COACH=
AI_MODEL_ANALYSIS=
AI_MONTHLY_BUDGET_USD=25

# ── Payments (Stripe, all optional; leave blank to disable) ──
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Misc ──
LOG_LEVEL=info
