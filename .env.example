# =====================================================================
# PROJECT_NEXUS — environment template (Phase DB-01: MongoDB + Redis)
# Copy to `.env` for local dev:  cp .env.example .env
# NEVER commit real secrets. Every VALUE below is a placeholder.
# Feature legend is in the comment above each key.
# PostgreSQL REMOVED from architecture — see
# docs/architecture/legacy-postgres-prisma-schema.md.
# =====================================================================

# ── Core runtime ─────────────────────────────────────────────
# Needed by: backend + frontend boot.
NODE_ENV=development # one of: development | test | production
APP_NAME=PROJECT_NEXUS
FRONTEND_URL=http://localhost:5173 # Needed by: CORS + OAuth callbacks + email links
ADMIN_URL=http://localhost:5174 # Needed by: CORS for the standalone admin console (admin/)
BACKEND_URL=http://localhost:3000 # Needed by: frontend SSR / health probes
API_URL=http://localhost:3000/api/v1 # Needed by: frontend API client
WS_URL=ws://localhost:3000/socket # Needed by: realtime game socket

# ── REQUIRED: databases ──────────────────────────────────────
# Needed by: backend durable persistence (users, games, ratings, ...).
MONGODB_URI=PASTE_YOUR_MONGODB_URI_HERE # e.g. mongodb://localhost:27017
# Needed by: Mongo database selection (dev vs test vs prod).
MONGODB_DB_NAME=project_nexus
# Needed by: realtime pub/sub, matchmaking queues, rate limits, session cache.
REDIS_URL=PASTE_YOUR_REDIS_URL_HERE # e.g. redis://localhost:6379
# Needed by: Redis key namespacing (multi-env sharing).
REDIS_PREFIX=project_nexus

# ── REQUIRED: auth / session secrets ─────────────────────────
# Needed by: JWT signing (access tokens). Generate: openssl rand -base64 48
JWT_SECRET=PASTE_YOUR_JWT_SECRET_HERE
# Needed by: signed cookies (web session).
COOKIE_SECRET=PASTE_YOUR_COOKIE_SECRET_HERE
# Needed by: express/session or equivalent server sessions.
SESSION_SECRET=PASTE_YOUR_SESSION_SECRET_HERE
# Needed by: CORS allowlist (comma-separated). Must include FRONTEND_URL in prod.
CORS_ORIGINS=http://localhost:5173

# ── Owner bootstrap (first super-admin) ─────────────────────
# Needed by: `pnpm owner:create` seed script. Password is single-use:
# change it on first login; it is hashed server-side with argon2/bcrypt.
# WARNING: OWNER_INITIAL_PASSWORD is bootstrap-only. Never reuse it elsewhere
# and never commit a real value.
OWNER_EMAIL=owner@example.com
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=PASTE_YOUR_BOOTSTRAP_PASSWORD_HERE

# ── OPTIONAL AI (all optional; at least one for AI features) ─
# Needed by: AI commentary / coaching / bot personalities.
AI_PROVIDER=groq # one of: groq | openai | anthropic | gemini | openrouter
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE # Needed by: default low-latency chat/completions
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE # Needed by: fallback chat + embeddings
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE # Needed by: deep-analysis provider option
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE # Needed by: Gemini provider option
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE # Needed by: OpenRouter gateway option
AI_MODEL_CHAT=PASTE_YOUR_CHAT_MODEL_HERE # e.g. provider-specific chat model id
AI_MODEL_COACH= # Needed by: AI coach explanations (defaults per provider when blank)
AI_MODEL_ANALYSIS=PASTE_YOUR_ANALYSIS_MODEL_HERE # Needed by: post-game analysis
AI_MODEL_TTS=PASTE_YOUR_TTS_MODEL_HERE # Needed by: text-to-speech commentary
TTS_ENABLED=false # Needed by: TTS feature flag
AI_MONTHLY_BUDGET_USD=25 # Needed by: cost-protection cap (see docs/ai/providers.md)

# ── OPTIONAL storage (S3-compatible) ─────────────────────────
# Needed by: avatars, game exports, replay files.
S3_ENDPOINT=PASTE_YOUR_S3_ENDPOINT_HERE # e.g. https://s3.example.com
S3_BUCKET=PASTE_YOUR_S3_BUCKET_HERE
S3_ACCESS_KEY=PASTE_YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=PASTE_YOUR_S3_SECRET_KEY_HERE
S3_REGION=auto

# ── OPTIONAL OAuth (social login; leave blank to disable) ────
# Needed by: Google sign-in (provider abstraction; buttons appear only when configured).
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
# Needed by: GitHub sign-in (same treatment as Google).
GITHUB_CLIENT_ID=PASTE_YOUR_GITHUB_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=PASTE_YOUR_GITHUB_CLIENT_SECRET_HERE

# ── OPTIONAL email (SMTP) ────────────────────────────────────
# Needed by: verification mail, password reset, notifications.
SMTP_HOST=PASTE_YOUR_SMTP_HOST_HERE
SMTP_PORT=587
SMTP_USER=PASTE_YOUR_SMTP_USER_HERE
SMTP_PASS=PASTE_YOUR_SMTP_PASS_HERE
MAIL_FROM=no-reply@example.com

# ── OPTIONAL payments (until monetisation phase) ─────────────
# Needed by: premium / tournament entry fees. Leave blank to disable.
PAYMENT_PROVIDER=none # one of: none | stripe | click | payme
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_HERE
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ── OPTIONAL domain tooling ──────────────────────────────────
# Needed by: scripts/domain/* availability + DNS checks.
DOMAINR_API_KEY=PASTE_YOUR_DOMAINR_KEY_HERE
CLOUDFLARE_API_TOKEN=PASTE_YOUR_CLOUDFLARE_TOKEN_HERE
CLOUDFLARE_ZONE_ID=PASTE_YOUR_CLOUDFLARE_ZONE_HERE

# ── OPTIONAL monitoring / observability (optional in dev) ────
# Needed by: error tracking, logs, uptime.
SENTRY_DSN=PASTE_YOUR_SENTRY_DSN_HERE
OTEL_ENDPOINT=PASTE_YOUR_OTEL_ENDPOINT_HERE # Needed by: OpenTelemetry log/metric export
LOG_LEVEL=info # one of: debug | info | warn | error
METRICS_ENABLED=false
UPTIME_PING_URL=
