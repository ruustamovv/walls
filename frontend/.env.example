# Frontend env template (Vite). Copy to `.env` for local dev.
# Only VITE_ prefixed vars are exposed to the browser — never secrets.

# Backend socket origin (falls back to window.location.origin).
VITE_WS_URL=ws://localhost:3000/socket

# Dev-only live TODO drawer (BUILD STATUS). Never enable in production.
VITE_DEV_TOOLS=false
