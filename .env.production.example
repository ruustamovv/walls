# PROJECT_NEXUS — production template. Fill via secret manager, not git.
# Placeholders only. See .env.example for field documentation.
# Persistence: MongoDB Atlas (or compatible) + Redis-compatible (e.g. Upstash).

NODE_ENV=production
APP_NAME=PROJECT_NEXUS
FRONTEND_URL=https://PASTE_YOUR_DOMAIN_HERE
BACKEND_URL=https://api.PASTE_YOUR_DOMAIN_HERE
API_URL=https://api.PASTE_YOUR_DOMAIN_HERE/api/v1
WS_URL=wss://api.PASTE_YOUR_DOMAIN_HERE/socket

MONGODB_URI=PASTE_YOUR_MONGODB_URI_HERE # e.g. mongodb+srv://USER:PASS@cluster/... (Atlas — never commit real value)
MONGODB_DB_NAME=project_nexus
REDIS_URL=PASTE_YOUR_REDIS_URL_HERE # e.g. rediss://... (Upstash — never commit real value)
REDIS_PREFIX=project_nexus

JWT_SECRET=PASTE_YOUR_JWT_SECRET_HERE
COOKIE_SECRET=PASTE_YOUR_COOKIE_SECRET_HERE
SESSION_SECRET=PASTE_YOUR_SESSION_SECRET_HERE
CORS_ORIGINS=https://PASTE_YOUR_DOMAIN_HERE

# Owner bootstrap is normally NOT used in production (owner already seeded).
# Only set for a fresh production bootstrap, then rotate immediately.
OWNER_EMAIL=owner@PASTE_YOUR_DOMAIN_HERE
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=PASTE_YOUR_BOOTSTRAP_PASSWORD_HERE

AI_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
AI_MODEL_CHAT=PASTE_YOUR_CHAT_MODEL_HERE
AI_MODEL_ANALYSIS=PASTE_YOUR_ANALYSIS_MODEL_HERE
AI_MONTHLY_BUDGET_USD=25
TTS_ENABLED=false

S3_ENDPOINT=PASTE_YOUR_S3_ENDPOINT_HERE
S3_BUCKET=PASTE_YOUR_S3_BUCKET_HERE
S3_ACCESS_KEY=PASTE_YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=PASTE_YOUR_S3_SECRET_KEY_HERE
S3_REGION=auto

SMTP_HOST=PASTE_YOUR_SMTP_HOST_HERE
SMTP_PORT=587
SMTP_USER=PASTE_YOUR_SMTP_USER_HERE
SMTP_PASS=PASTE_YOUR_SMTP_PASS_HERE
MAIL_FROM=no-reply@PASTE_YOUR_DOMAIN_HERE

SENTRY_DSN=PASTE_YOUR_SENTRY_DSN_HERE
LOG_LEVEL=warn
METRICS_ENABLED=true
