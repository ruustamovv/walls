# PROJECT_NEXUS — local dev overrides (copy to `.env` or `.env.local`).
# Placeholders only. See .env.example for the full reference.
# Persistence: MongoDB (durable) + Redis (ephemeral). No PostgreSQL.

NODE_ENV=development
APP_NAME=PROJECT_NEXUS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
WS_URL=ws://localhost:3000/socket

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=project_nexus
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=project_nexus

JWT_SECRET=PASTE_YOUR_JWT_SECRET_HERE
COOKIE_SECRET=PASTE_YOUR_COOKIE_SECRET_HERE
SESSION_SECRET=PASTE_YOUR_SESSION_SECRET_HERE
CORS_ORIGINS=http://localhost:5173

OWNER_EMAIL=owner@example.com
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=PASTE_YOUR_BOOTSTRAP_PASSWORD_HERE

AI_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
AI_MODEL_CHAT=PASTE_YOUR_CHAT_MODEL_HERE
TTS_ENABLED=false

LOG_LEVEL=debug
